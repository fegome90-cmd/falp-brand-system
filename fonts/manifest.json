{
  "name": "FALP Typography System",
  "version": "0.1.0",
  "institutional_print_authority": {
    "source": "manuales/6Tipografias.pdf",
    "primary": "Myriad Pro",
    "secondary": "Source Sans Pro",
    "tertiary": "Calibri",
    "usage": "Papelería institucional, documentos oficiales impresos, memorias anuales"
  },
  "digital_web_derived": {
    "display": {
      "family": "Montserrat",
      "weights": ["600", "750", "800", "850", "900"],
      "files": ["fonts/montserrat-600-900.woff2"],
      "tracking": "-0.045em",
      "line_height": "1.02-1.04",
      "fallbacks": ["Inter", "ui-sans-serif", "system-ui", "sans-serif"],
      "usage": "Títulos hero, portadas, cabeceras de diapositivas ejecutivas"
    },
    "body": {
      "family": "Inter",
      "weights": ["400", "600", "750", "800"],
      "files": ["fonts/inter-400-800.woff2"],
      "fallbacks": [
        "ui-sans-serif",
        "system-ui",
        "-apple-system",
        "BlinkMacSystemFont",
        "Segoe UI",
        "sans-serif"
      ],
      "usage": "Cuerpo de texto, labels de componentes, tablas y cards"
    }
  }
}
