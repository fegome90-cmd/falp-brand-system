{
  "name": "FALP Typography System",
  "version": "0.1.1",
  "institutional_print_authority": {
    "source": "manuales/6Tipografias.pdf",
    "primary": "Myriad Pro",
    "secondary": "Source Sans Pro",
    "tertiary": "Calibri",
    "usage": "Papelería institucional, documentos oficiales impresos, memorias anuales"
  },
  "digital_web_derived": {
