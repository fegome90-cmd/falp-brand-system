      "family": "Montserrat",
      "weights": ["600", "750", "800", "850", "900"],
      "files": ["fonts/montserrat-600-900.woff2"],
      "tracking": "-0.045em",
      "line_height": "1.02-1.04",
      "fallbacks": ["Inter", "ui-sans-serif", "system-ui", "sans-serif"],
      "usage": "Títulos hero, portadas, cabeceras de diapositivas ejecutivas",
      "subset": "latin",
      "source_url": "https://fonts.gstatic.com/s/montserrat/v31/JTUSjIg1_i6t8kCHKm459WlhyyTh89Y.woff2",
      "license": "fonts/Montserrat-OFL.txt",
      "coverage": "Latin alphabet, Latin-1 Spanish accents and punctuation; verified from binary cmap"
    },
    "body": {
      "family": "Inter",
      "weights": ["400", "600", "750", "800"],
      "files": ["fonts/inter-400-800.woff2"],
      "fallbacks": [
        "ui-sans-serif",
        "system-ui",
        "-apple-system",
        "BlinkMacSystemFont",
        "Segoe UI",
        "sans-serif"
      ],
      "usage": "Cuerpo de texto, labels de componentes, tablas y cards",
      "subset": "latin",
      "source_url": "https://fonts.gstatic.com/s/inter/v20/UcC73FwrK3iLTeHuS_nVMrMxCp50SjIa1ZL7W0Q5nw.woff2",
      "license": "fonts/Inter-OFL.txt",
      "coverage": "Latin alphabet, Latin-1 Spanish accents and punctuation; verified from binary cmap"
    }
  }
}
